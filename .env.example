# PriceShock Environment Configuration
# Copy this file to .env and fill in your values

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend -> Backend API URL (set to your deployed backend URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite by default; point to Postgres URL in production if desired)
DATABASE_URL=sqlite:///./priceshock.db

# Application
APP_NAME=PriceShock
APP_VERSION=1.0.0
ENVIRONMENT=development
