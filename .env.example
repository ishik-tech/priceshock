# PriceShock Environment Configuration
# Copy this file to .env and fill in your values

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./priceshock.db

# ML Configuration
ML_MODEL_PATH=./ml/models
DATA_PATH=./ml/data

# Optional: MoSPI API Key (leave empty to use local data)
MOSPI_API_KEY=

# Optional: Commodity API Key (leave empty to use local data)
COMMODITY_API_KEY=

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Application
APP_NAME=PriceShock
APP_VERSION=1.0.0
ENVIRONMENT=development